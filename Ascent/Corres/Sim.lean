import Ascent.Corres.Basic

/-!
# `sim`: the relational weakest precondition

`sim r a c Q` is the weakest concrete-state precondition under which the abstract program `a`
simulates the concrete program `c` with relational postcondition `Q : AVal → CVal → CPred`; the
signature mirrors `wp x Q E`, with exceptional behavior concretized by `r.ePred`. A
correspondence is the triple-shaped entailment `pre ⊑ sim r a c Q` (`corres_iff_le_sim`).

`esim r` is the exception coupling induced by the concretization: it stands to thrown values as
`sim r` stands to programs. `sim_pure`/`sim_bind` are the relational monad laws (`bind` embeds
the continuations' `sim` in `Q`); `sim_throw`/`sim_tryCatch` are their exceptional mirrors (per
effect, here for `Except`): `throw` consumes `esim r` as `pure` consumes `Q`, and `tryCatch`
composes handler correspondences at `esim r` preconditions, given that `r.ePred`'s layer is
generated by `r.pred` through `esim r`.
-/

open Std.Internal.Do Lean.Order

namespace Ascent

universe u v w w'

section
variable {CProg AProg : Type _} {CVal AVal : Type _}
  {CPred APred : Type w} {CEPred AEPred : Type w'}
  [Assertion CPred] [Assertion APred] [Assertion CEPred] [Assertion AEPred]
  [WP CProg CVal CPred CEPred] [WP AProg AVal APred AEPred]

/-- The relational weakest precondition: the weakest concrete-state predicate under which every
abstract `wp` fact concretizes to the concrete `wp` at the coupled postconditions. -/
noncomputable def sim (r : Concretization CPred APred CEPred AEPred)
    (a : AProg) (c : CProg) (Q : AVal → CVal → CPred) : CPred :=
  iInf fun Qa : AVal → APred => iInf fun Ea : AEPred =>
    r.pred (wp a Qa Ea) ⇨ wp c (r.post Q Qa) (r.ePred Ea)

/-- A correspondence entails the relational weakest precondition. -/
theorem Corres.le_sim {r : Concretization CPred APred CEPred AEPred}
    {b : Boundary CPred AVal CVal} {a : AProg} {c : CProg} (h : Corres r b a c) :
    b.pre ⊑ sim r a c b.couple :=
  le_iInf _ _ fun Qa => le_iInf _ _ fun Ea =>
    himp_complete _ _ _ (PartialOrder.rel_trans CompleteLattice.meet_le_comm (h Qa Ea))

/-- The relational weakest precondition is a valid boundary precondition. -/
theorem corres_sim [Frame CPred] {r : Concretization CPred APred CEPred AEPred}
    {Q : AVal → CVal → CPred} {a : AProg} {c : CProg} :
    Corres r ⟨sim r a c Q, Q⟩ a c := fun Qa Ea =>
  CompleteLattice.meet_le_of_le_himp
    (PartialOrder.rel_trans (iInf_le _ Qa) (iInf_le _ Ea))

/-- Any entailment into the relational weakest precondition is a correspondence. -/
theorem corres_of_le_sim [Frame CPred] {r : Concretization CPred APred CEPred AEPred}
    {pre : CPred} {Q : AVal → CVal → CPred} {a : AProg} {c : CProg}
    (hle : pre ⊑ sim r a c Q) : Corres r ⟨pre, Q⟩ a c := fun Qa Ea =>
  PartialOrder.rel_trans
    (le_meet _ _ _ (PartialOrder.rel_trans (meet_le_left _ _) hle) (meet_le_right _ _))
    (corres_sim Qa Ea)

/-- A correspondence is exactly an entailment into the relational weakest precondition. -/
theorem corres_iff_le_sim [Frame CPred] {r : Concretization CPred APred CEPred AEPred}
    {pre : CPred} {Q : AVal → CVal → CPred} {a : AProg} {c : CProg} :
    Corres r ⟨pre, Q⟩ a c ↔ pre ⊑ sim r a c Q :=
  ⟨Corres.le_sim, corres_of_le_sim⟩

end

section
variable {CM AM : Type w → Type v} {CPred APred : Type w} {CEPred AEPred : Type w'}
  [Monad CM] [Monad AM]
  [Assertion CPred] [Assertion APred] [Assertion CEPred] [Assertion AEPred]
  [WPMonad CM CPred CEPred] [WPMonad AM APred AEPred] [WPMonadExact AM APred AEPred]
  {r : Concretization CPred APred CEPred AEPred}

/-- The relational unit law: the relational postcondition at the returned values entails the
`sim` of the `pure`s. -/
theorem sim_pure {AV CV : Type w} {Q : AV → CV → CPred} (av : AV) (cv : CV) :
    Q av cv ⊑ sim r (pure av : AM AV) (pure cv : CM CV) Q := by
  refine le_iInf _ _ fun Qa => le_iInf _ _ fun Ea => ?_
  refine himp_complete _ _ _ (PartialOrder.rel_trans CompleteLattice.meet_le_comm ?_)
  refine PartialOrder.rel_trans (le_meet _ _ _ (meet_le_left _ _)
    (PartialOrder.rel_trans (meet_le_right _ _)
      (r.pred_mono ((‹WPMonadExact AM APred AEPred›).wp_pure_le av Qa Ea)))) ?_
  exact PartialOrder.rel_trans (le_iSup (fun av' => Q av' cv ⊓ r.pred (Qa av')) av)
    (WPMonad.pure_le_wp_pure cv (r.post Q Qa) (r.ePred Ea))

/-- The relational bind law: embedding the continuations' `sim` in the relational postcondition
bounds the `sim` of the `bind`s. -/
theorem sim_bind [Frame CPred] {CV AV CV₂ AV₂ : Type w}
    {a₁ : AM AV} {c₁ : CM CV} {a₂ : AV → AM AV₂} {c₂ : CV → CM CV₂}
    {Q : AV₂ → CV₂ → CPred} :
    sim r a₁ c₁ (fun av cv => sim r (a₂ av) (c₂ cv) Q) ⊑
      sim r (a₁ >>= a₂) (c₁ >>= c₂) Q := by
  refine le_iInf _ _ fun Qa => le_iInf _ _ fun Ea => ?_
  refine himp_complete _ _ _ (PartialOrder.rel_trans CompleteLattice.meet_le_comm ?_)
  refine PartialOrder.rel_trans (le_meet _ _ _ (meet_le_left _ _)
    (PartialOrder.rel_trans (meet_le_right _ _)
      (r.pred_mono ((‹WPMonadExact AM APred AEPred›).wp_bind_le a₁ a₂ Qa Ea)))) ?_
  refine PartialOrder.rel_trans
    (CompleteLattice.meet_le_of_le_himp
      (PartialOrder.rel_trans (iInf_le _ (fun av => wp (a₂ av) Qa Ea)) (iInf_le _ Ea))) ?_
  refine PartialOrder.rel_trans
    (WP.wp_consequence c₁ _
      (fun cv => wp (c₂ cv) (r.post Q Qa) (r.ePred Ea)) (r.ePred Ea) ?_)
    (WPMonad.bind_le_wp_bind c₁ c₂ (r.post Q Qa) (r.ePred Ea))
  intro cv
  show iSup (fun av => sim r (a₂ av) (c₂ cv) Q ⊓ r.pred (wp (a₂ av) Qa Ea)) ⊑ _
  refine iSup_le _ _ fun av => ?_
  exact CompleteLattice.meet_le_of_le_himp
    (PartialOrder.rel_trans (iInf_le _ Qa) (iInf_le _ Ea))

/-- `corres_bind` at the weakest mid-condition: the continuation obligation is `corres_sim`,
leaving the head correspondence and one `wp` fact about the concrete head. -/
theorem corres_bind_pre [Frame CPred] {CV AV CV₂ AV₂ : Type w}
    [WPConjunctive (CM CV) CV CPred CEPred]
    (pre : CPred) (couple : CV → AV) (couple₂ : CV₂ → AV₂)
    {a₁ : AM AV} {c₁ : CM CV} {a₂ : AV → AM AV₂} {c₂ : CV → CM CV₂}
    (hc : Corres r (.eq pre couple) a₁ c₁)
    (hmid : pre ⊑
      wp c₁ (fun cv => sim r (a₂ (couple cv)) (c₂ cv) (coupleEq couple₂)) ⊥) :
    Corres r (.eq pre couple₂) (a₁ >>= a₂) (c₁ >>= c₂) :=
  corres_bind pre _ couple couple₂ hc hmid fun _ => corres_sim

/-- The erased-leaf `bind` at the weakest mid-condition. -/
theorem corres_bind_erase_pre [Frame CPred] {CV AV CV₂ AV₂ : Type w}
    [WPConjunctive (CM CV) CV CPred CEPred]
    (pre : CPred) (couple : CV → AV) (couple₂ : CV₂ → AV₂)
    {v : AV} {c₁ : CM CV} {a : AM AV₂} {c₂ : CV → CM CV₂}
    (hc : Corres r (.eq pre couple) (pure v : AM AV) c₁)
    (hmid : pre ⊑ wp c₁ (fun cv => sim r a (c₂ cv) (coupleEq couple₂)) ⊥) :
    Corres r (.eq pre couple₂) a (c₁ >>= c₂) :=
  corres_bind_erase pre _ couple couple₂ hc hmid fun _ => corres_sim

end

section
variable {εa εc AV CV : Type}
  {r : Concretization Prop Prop (EPost.Cons (εc → Prop) EPost.Nil)
    (EPost.Cons (εa → Prop) EPost.Nil)}

/-- The exception coupling induced by the concretization: the weakest relation on thrown values
under which the abstract barrel concretizes to the concrete one. `esim r` stands to exception
values as `sim r` stands to programs. -/
noncomputable def esim (r : Concretization Prop Prop (EPost.Cons (εc → Prop) EPost.Nil)
    (EPost.Cons (εa → Prop) EPost.Nil)) (ea : εa) (ec : εc) : Prop :=
  iInf fun Ea : EPost.Cons (εa → Prop) EPost.Nil =>
    r.pred (Ea.head ea) ⇨ (r.ePred Ea).head ec

/-- The relational throw law: `throw` consumes the induced exception coupling as `pure`
consumes the relational postcondition. -/
theorem sim_throw {Q : AV → CV → Prop} (ea : εa) (ec : εc) :
    esim r ea ec ⊑
      sim r (MonadExceptOf.throw ea : Except εa AV)
        (MonadExceptOf.throw ec : Except εc CV) Q := by
  refine le_iInf _ _ fun Qa => le_iInf _ _ fun Ea => ?_
  refine himp_complete _ _ _ (PartialOrder.rel_trans CompleteLattice.meet_le_comm ?_)
  simp only [WPMonad.wp_throw_Except_apply_eq]
  exact CompleteLattice.meet_le_of_le_himp (iInf_le _ Ea)

/-- The relational tryCatch law: handler correspondences at `esim` preconditions compose,
given that `r.ePred`'s layer is generated by `r.pred` through `esim r` (`hgen`; automatic for
reify-built `ePred`s). The exceptional mirror of `sim_bind`. -/
theorem sim_tryCatch {Q : AV → CV → Prop}
    {ax : Except εa AV} {cx : Except εc CV}
    {ah : εa → Except εa AV} {ch : εc → Except εc CV}
    (hgen : ∀ (Ea : EPost.Cons (εa → Prop) EPost.Nil) (ec : εc),
      (r.ePred Ea).head ec ⊑ iSup fun ea => esim r ea ec ⊓ r.pred (Ea.head ea))
    (hh : ∀ ea ec, esim r ea ec ⊑ sim r (ah ea) (ch ec) Q) :
    sim r ax cx Q ⊑
      sim r (MonadExceptOf.tryCatch ax ah) (MonadExceptOf.tryCatch cx ch) Q := by
  refine le_iInf _ _ fun Qa => le_iInf _ _ fun Ea => ?_
  refine himp_complete _ _ _ (PartialOrder.rel_trans CompleteLattice.meet_le_comm ?_)
  simp only [WPMonad.wp_tryCatch_Except_apply_eq]
  refine PartialOrder.rel_trans
    (CompleteLattice.meet_le_of_le_himp
      (PartialOrder.rel_trans (iInf_le _ Qa)
        (iInf_le _ (epost⟨fun ea => wp (ah ea) Qa Ea⟩)))) ?_
  refine WP.wp_consequence_econs cx _ _ _ _ PartialOrder.rel_refl ?_
  refine EPost.Cons.mk_le _ _ _ ?_ PartialOrder.rel_refl
  intro ec
  refine PartialOrder.rel_trans (hgen _ ec) ?_
  refine iSup_le _ _ fun ea => ?_
  exact CompleteLattice.meet_le_of_le_himp
    (PartialOrder.rel_trans (hh ea ec)
      (PartialOrder.rel_trans (iInf_le _ Qa) (iInf_le _ Ea)))

end

end Ascent
