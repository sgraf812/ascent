+  if x.isFVar then return some (.keep x)
+  if !x.hasFVar && !x.hasMVar then
+    let ty ← Sym.inferType x
+    if ty.isConstOf ``Unit || ty.isAppOf ``PUnit || (← Sym.inferType ty).isProp then
+      return some .drop
+    return none
+  return (← structPaths x).map .fields
