+/-- The argument `x` of a hole as seen by `fillAbstractHole`: a free variable stays an argument, a
+closed term of a subsingleton type (`Unit`, `PUnit`, a proof) is dropped, and a structure
+instance whose fields are free variables contributes its fields. -/
+inductive HoleArg where
+  | keep (x : Expr)
+  | drop
+  /-- The free variables of a structure instance, each with the projection functions, applied to
+  the structure parameters, that read it off the instance, outermost first. -/
+  | fields (paths : Array (Array Expr × Expr))
+
+partial def structPaths (x : Expr) : SymM (Option (Array (Array Expr × Expr))) := do
+  if x.isFVar then return some #[(#[], x)]
+  let .const ctor us := x.getAppFn | return none
+  let env ← getEnv
+  let some (.ctorInfo cv) := env.find? ctor | return none
+  let some info := getStructureInfo? env cv.induct | return none
+  let ps := x.getAppArgs.extract 0 cv.numParams
+  let fs := x.getAppArgs.extract cv.numParams x.getAppNumArgs
+  unless fs.size == cv.numFields && ps.all (!·.hasFVar) do return none
+  let mut paths := #[]
+  for f in info.fieldNames, a in fs do
+    let some p := getProjFnForField? env cv.induct f | return none
+    let some sub ← structPaths a | return none
+    for (ch, y) in sub do
+      paths := paths.push (#[mkAppN (.const p us) ps] ++ ch, y)
+  return some paths
+
+def classifyHoleArg (x : Expr) : SymM (Option HoleArg) := do
+  if x.isFVar then return some (.keep x)
+  if !x.hasFVar && !x.hasMVar then
+    let ty ← Sym.inferType x
+    if ty.isConstOf ``Unit || ty.isAppOf ``PUnit || (← Sym.inferType ty).isProp then
+      return some .drop
+    return none
+  return (← structPaths x).map .fields
+
+/-- Rewrite the hole `?h xs` whose arguments `classifyHoleArg` accepts into `?h' ys`, applied to
+the distinct free variables `ys` of `xs`: `?h := fun x₁ … xₙ => ?h' ys'`, where `ys'` reads each
+variable off its argument (the argument itself, or a projection of a structure argument). The type
+of `?h` must not depend on its arguments. Returns `?h'` and `ys`. -/
+def patternHole? (hole : MVarId) (xs : Array Expr) : VCGenM (Option (Expr × Array Expr)) := do
+  let mut cls := #[]
+  for x in xs do
+    let some c ← classifyHoleArg x | return none
+    cls := cls.push c
+  let ys := cls.foldl (init := #[]) fun acc c => match c with
+    | .keep x => acc.push x
+    | .drop => acc
+    | .fields ps => acc ++ ps.map (·.2)
+  unless (ys.toList.map (·.fvarId!)).eraseDups.length == ys.size do return none
+  let decl ← hole.getDecl
+  let mut ty ← instantiateMVars decl.type
+  let mut doms := #[]
+  for _ in [0:xs.size] do
+    let .forallE nm d body _ := ty | return none
+    doms := doms.push (nm, d)
+    ty := body
+  if ty.hasLooseBVars || doms.any (·.2.hasLooseBVars) then return none
+  let mut yTys := #[]
+  for y in ys do
+    let yTy ← instantiateMVars (← Sym.inferType y)
+    if yTy.hasFVar || yTy.hasMVar then return none
+    yTys := yTys.push yTy
+  let ty' := (ys.zip yTys).foldr (fun (y, yTy) acc => .forallE `y yTy acc .default) ty
+  let h' ← mkFreshExprMVarAt decl.lctx decl.localInstances ty'
+  let n := xs.size
+  let mut body := #[]
+  for i in [0:n], c in cls do
+    match c with
+    | .keep _ => body := body.push (.bvar (n - 1 - i))
+    | .drop => pure ()
+    | .fields ps => for (ch, _) in ps do
+        body := body.push (ch.foldl (fun acc p => .app p acc) (.bvar (n - 1 - i)))
+  hole.assign <| doms.foldr (fun (nm, d) acc => .lam nm d acc .default) (mkAppN h' body)
+  return some (h', ys)
+
+/-- Fill an unassigned hole in the abstract program of `goal` with a fresh metavariable `?b` of the
+goal's context, which a rule then assigns. A bare hole is assigned `?b`. A hole `?h xs` applied to
+distinct free variables gets the delayed assignment `?h xs := ?b`. A hole applied to closed terms,
+such as the continuation `?k ()` of a bind whose first action returns `()`, is assigned the
+constant function `fun _ => ?b`. A hole whose spine mixes free variables, closed terms of a
+subsingleton type and structure instances of free variables, such as `?f () a` or `?f (a, b)`, is
+solved through the partial inverse of its spine, as in nested pattern unification (Kovács and
+Bocquet, WITS 2023): `(a, b)` inverts to the projections of the bound argument, and a closed
+subsingleton argument inverts to nothing. The result is a hole `?h'` applied to the free variables
+(`patternHole?`), which gets the delayed assignment. A table slot `Table.get ?tbl k` at a closed key gets the cell of `k` (`tableCell`). In
+every case the goal's abstract program becomes the cell. The frontend resolves the delayed
+assignments after the run. Returns the new goal and, for a filled hole, the hole's declaration,
+the hole's arguments and `?b`. -/
+def fillAbstractHole (goal : MVarId) (info : WRPApp) :
+    VCGenM (MVarId × Option (MetavarDecl × Array Expr × Expr)) := do
+  let mut goal := goal
+  let mut filled : Option (MetavarDecl × Array Expr × Expr) := none
+  let abs ← instantiateMVarsIfMVarAppS info.abs
+  if abs.isAppOfArity ``Distillery.Table.get 6 then
+    if let some (decl?, b) ← tableCell abs then
+      if let some decl := decl? then filled := some (decl, #[], b)
+      goal ← setAbs goal info b
+  else if let .mvar hole := abs.getAppFn then
+    let xs := abs.getAppArgs
+    let distinct := xs.all (·.isFVar) && (xs.toList.map (·.fvarId!)).eraseDups.length == xs.size
+    let closed := xs.all fun x => !x.hasFVar && !x.hasMVar
+    if (← hole.getKind) matches .natural && !(← hole.isDelayedAssigned) && (distinct || closed) then
+      let b ← shareCommon (← mkFreshExprMVar (← Sym.inferType abs))
+      filled := some (← hole.getDecl, if closed then #[] else xs, b)
+      if xs.isEmpty then
+        hole.assign b
+      else if closed then
+        let mut ty ← instantiateMVars (← hole.getType)
+        let mut doms := #[]
+        for _ in [0:xs.size] do
+          let .forallE nm d body _ := ty
+            | throwError "distill: the hole {mkMVar hole} applied to {xs} has no function type"
+          doms := doms.push (nm, d)
+          ty := body
+        hole.assign <| doms.foldr (fun (nm, d) acc => .lam nm d acc .default) b
+      else
+        assignDelayedMVar hole xs b.mvarId!
+        goal ← setAbs goal info b
+    else if (← hole.getKind) matches .natural && !(← hole.isDelayedAssigned) then
+      if let some (h', ys) ← patternHole? hole xs then
+        let b ← shareCommon (← mkFreshExprMVar (← Sym.inferType abs))
+        filled := some (← h'.mvarId!.getDecl, ys, b)
+        assignDelayedMVar h'.mvarId! ys b.mvarId!
+        goal ← setAbs goal info b
+  return (goal, filled)
+
+/-- `true` iff the abstract program of the filled hole `filled` uses only the hole's context and the
+hole's arguments. -/
+def filledInScope (filled : Option (MetavarDecl × Array Expr × Expr)) : VCGenM Bool := do
+  let some (decl, xs, b) := filled | return true
+  let v ← instantiateMVarsS b
+  return !v.hasAnyFVar fun fv => !decl.lctx.contains fv && !xs.contains (.fvar fv)
+
+/-- Give the holes that a rule left in the abstract program of the filled hole `filled` the hole's
+context. A rule creates its holes in the goal's context, which also holds the variables that the run
+introduced, such as the concrete state. The abstract program uses none of them (`filledInScope`),
+and a table shares the program with the goals of the other cells. A hole of a delayed assignment
+`?h xs := ?b` keeps its context, since `?b` occurs only behind `?h`. With `withArgs`, the holes of a
+delayed assignment `?h xs := ?b` take the context of `?h` extended by `xs`, so that a later split in
+a branch recognizes the concrete state as outside of the branch's hole (`outsideHole?`). The maximal
+free variable of a term with a hole depends on the hole's context, so the cache of
+`Sym.getMaxFVar?` starts afresh after a change. -/
+def restoreHoleScope (filled : Option (MetavarDecl × Array Expr × Expr)) (withArgs := false) :
+    VCGenM Unit := do
+  let some (decl, xs, b) := filled | return
+  unless xs.isEmpty || withArgs do return
+  let mut lctx := decl.lctx
+  for x in xs do
+    let xd ← x.fvarId!.getDecl
+    let out (e : Expr) := e.hasAnyFVar (!lctx.contains ·)
+    if out (← instantiateMVars xd.type) || xd.value?.any out then return
+    lctx := lctx.addDecl xd
+  let outOfScope (e : Expr) := e.hasAnyFVar fun fv => !lctx.contains fv
+  let mut changed := false
+  for mv in ← getMVars (← instantiateMVarsS b) do
+    let d ← mv.getDecl
+    unless d.kind matches .natural do continue
+    unless d.lctx.numIndices > decl.lctx.numIndices do continue
+    if outOfScope (← instantiateMVars d.type) then continue
+    modifyMCtx (·.modifyExprMVarDecl mv fun d =>
+      { d with lctx, localInstances := decl.localInstances })
+    changed := true
+  if changed then
+    (modify fun s => { s with maxFVar := {} } : Sym.SymM Unit)
+
+/-- A fresh hole of type `β` in the current context. For a tuple type (`Prod`, `MProd`, `PProd`), the
+hole is the pair of fresh holes for the components, so that a `match` on the witness reduces. -/
+partial def mkWitnessHole (β : Expr) : VCGenM Expr := do
+  let env ← getEnv
+  let .const S us := β.getAppFn | return ← shareCommon (← mkFreshExprMVar β)
+  unless S == ``Prod || S == ``MProd || S == ``PProd do return ← shareCommon (← mkFreshExprMVar β)
+  let some info := getStructureInfo? env S | return ← shareCommon (← mkFreshExprMVar β)
+  let ctor := getStructureCtor env S
+  let params := β.getAppArgs
+  unless params.size == ctor.numParams do return ← shareCommon (← mkFreshExprMVar β)
+  let mut ty := ctor.type.instantiateLevelParams ctor.levelParams us
+  for p in params do
+    let .forallE _ _ body _ := ty | return ← shareCommon (← mkFreshExprMVar β)
+    ty := body.instantiate1 p
+  let mut fields := #[]
+  for _ in [0:info.fieldNames.size] do
+    let .forallE _ d body _ := ty | return ← shareCommon (← mkFreshExprMVar β)
+    let f ← mkWitnessHole (← shareCommon d)
+    fields := fields.push f
+    ty := body.instantiate1 f
+  mkAppNS (← mkConstS ctor.name us) (params ++ fields)
+
+/-- Strategy 9b: introduce an existential on the `Prop` lattice. The witness of `pre ⊑ ∃ x, p x` is a
+fresh hole `?x` in the goal's context (`mkWitnessHole`), and the goal continues as `pre ⊑ p ?x`. -/
+def rhsExistsIntro? (goal : MVarId) (α pre rhs : Expr) : VCGenM (Option MVarId) := do
+  unless α.isProp do return none
+  let_expr Exists β p := rhs | return none
+  let x ← mkWitnessHole β
+  let px ← betaS p #[x]
+  let target ← goal.getType
+  let g ← mkFreshExprSyntheticOpaqueMVar (← mkAppNS target.getAppFn (target.getAppArgs.set! 3 px))
+  goal.assign (mkApp5 (mkConst ``Distillery.le_exists_of_le [← Sym.getLevel β]) β pre p x g)
+  return some g.mvarId!
+
+/-- The test whether a term mentions a free variable outside the context of the abstract hole of
+`info`, or `none` if the abstract program is not a hole. -/
+def outsideHole? (info : WRPApp) : VCGenM (Option (Expr → Bool)) := do
+  let abs ← instantiateMVarsIfMVarAppS info.abs
+  let .mvar hole := abs.getAppFn | return none
+  let decl ← hole.getDecl
+  let xs := abs.getAppArgs
+  return some fun e => e.hasAnyFVar fun fv => !decl.lctx.contains fv && !xs.contains (.fvar fv)
+
+/-- Distill a `let` or `have` of a pure value into a `let` or `have` of the abstract
+value. For `have x := e; b` and an abstract hole, the hole becomes `have x' := ?e'; ?k x'`, the value
+solver closes `PureRefinement x ?e' True ?R` for the local definition `x := e`, and the run
+continues on `b` and `?k x'` with the entry `PureRefinement x x' True R`. An abstract program
+`have x' := e'; k'` that another branch synthesized gives the goal `PureRefinement x e' True ?R`
+and the continuation `k'`. The guards of the solution are verification conditions. A value that no rule abstracts falls through to `wpLet?`. -/
+def wpHaveAbs? (goal : MVarId) (info : WRPApp) : VCGenM (Option (List MVarId)) := do
+  let .letE name type val body nondep := info.prog | return none
+  if isDuplicable (← reduceHead val) || Lean.Elab.Tactic.Do.isJP name then return none
+  let abs ← instantiateMVarsS info.abs
+  let isHole := abs.getAppFn.isMVar
+  unless isHole || abs.isLet do return none
+  let saved ← (saveState : MetaM Meta.SavedState)
+  let some gs ← goal.withContext do
+    let .sort (.succ u) ← instantiateMVarsS (← Sym.inferType type) | return none
+    -- The abstract binding: a fresh `have x' := ?e'; ?k x'` in the hole, or the binding of an
+    -- abstract program that another branch synthesized.
+    let (goal, b, α', e', k) ← if isHole then do
+        let (goal, filled) ← fillAbstractHole goal info
+        let some (_, _, b) := filled | return none
+        let v ← mkFreshLevelMVar
+        let α' ← shareCommon (← mkFreshExprMVar (← mkSortS (.succ v)))
+        let e' ← shareCommon (← mkFreshExprMVar α')
+        let k ← shareCommon (← mkFreshExprMVar (← mkForallS name .default α' (← Sym.inferType b)))
+        b.mvarId!.assign (← mkLetS name α' e' (← mkAppS k (← mkBVarS 0)) nondep)
+        restoreHoleScope filled (withArgs := true)
+        pure (goal, b, α', e', k)
+      else do
+        let .letE name' α' e' body' _ := abs | return none
+        pure (goal, abs, α', e', ← mkLambdaS name' .default α' body')
+    let .sort (.succ v) ← instantiateMVarsS (← Sym.inferType α') | return none
+    let R ← shareCommon (← mkFreshExprMVar
+      (← mkForallS `c .default type (← mkForallS `a .default α' (← mkSortS .zero))))
+    let wp ← mkAppNS info.head ((info.args.set! WRPApp.progIdx body).set! (WRPApp.progIdx + 1) b)
+    let (x, goal) ← introLet goal name type val (← mkAppNS wp info.excessArgs) nondep
+    goal.withContext do
+    let xE ← mkFVarS x
+    let PR ← mkConstS ``Distillery.PureRefinement [u, v]
+    let tru ← mkConstS ``True
+    let hpr ← mkFreshExprSyntheticOpaqueMVar
+      (← shareCommon (← mkAppNS PR #[type, α', xE, e', tru, R]))
+    let target ← goal.getType
+    let relArgs := target.getAppArgs
+    let rhs := relArgs.back!
+    let contTy ← withLocalDeclD name α' fun x' => do
+      let x' ← mkFVarS x'.fvarId!
+      withLocalDeclD `hx (← mkAppNS PR #[type, α', xE, x', tru, R]) fun hx => do
+        let hx ← mkFVarS hx.fvarId!
+        let rhs' ← mkAppNS rhs.getAppFn (rhs.getAppArgs.set! (WRPApp.progIdx + 1) (← betaS k #[x']))
+        let rel ← mkAppNS target.getAppFn (relArgs.set! (relArgs.size - 1) rhs')
+        mkForallFVarsS #[x', hx] rel
+    let cont ← mkFreshExprSyntheticOpaqueMVar (← shareCommon contTy) (← goal.getTag)
+    goal.assign (mkApp2 cont e' hpr)
+    let some solved ← (try some <$> solvePureRefinement hpr.mvarId! catch _ => pure none)
+      | return none
+    let mut vcs := #[]
+    for vc in solved do
+      let ty ← instantiateMVarsS (← vc.getType)
+      if let some (T, lhs, rhs) := ty.eq? then
+        if (← instantiateMVarsS rhs).isMVar then
+          if ← isDefEqS rhs lhs then
+            vc.assign (mkApp2 (mkConst ``Eq.refl [← Sym.getLevel T]) T lhs)
+            continue
+      vcs := vcs.push vc
+    let .goal _ g ← Sym.introN cont.mvarId! 2
+      | throwError "distill: failed to introduce the abstract value of the `have` {name}"
+    trace[Elab.Tactic.Do.vcgen] "have-abstract: {name} ↦ {← instantiateMVarsS e'}"
+    return some (g :: vcs.toList)
+    | (saved.restore : MetaM Unit); return none
+  return some gs
+
+/-- An abstract join point: the join point `jp` of the concrete program, the abstract join point
+`jp'`, and for each join parameter the abstract type and the relation of its entry, or `none` for a
+`PUnit` parameter, which `jp'` takes as it is. -/
+structure AbsJoinPoint where
+  jp : JoinPoint
+  abs : Expr
+  params : Array (Option (Expr × Expr))
+  deriving Inhabited
+
+/-- The abstract join points of the run, keyed by the variable of the concrete join point. -/
+initialize absJoinPointsExt : SymExtension (Std.HashMap FVarId AbsJoinPoint) ←
+  registerSymExtension (pure {})
+
+/-- The `PureRefinement` goal `PureRefinement c c' True R` at the universes of `T` and `τ`. -/
+def mkEntryType (T τ c c' R : Expr) : VCGenM Expr := do
+  let u := (← Sym.getLevel T).dec.getD .zero
+  let v := (← Sym.getLevel τ).dec.getD .zero
+  mkAppNS (← mkConstS ``Distillery.PureRefinement [u, v]) #[T, τ, c, c', ← mkConstS ``True, R]
+
+/-- Close the equations `av = ?av'` among the verification conditions `vcs` of the value solver by
+`rfl`, and return the others. -/
+def closeValEqs (vcs : List MVarId) : VCGenM (List MVarId) := do
+  let mut rest := #[]
+  for vc in vcs do
+    let ty ← instantiateMVarsS (← vc.getType)
+    if let some (T, lhs, rhs) := ty.eq? then
+      if (← instantiateMVarsS rhs).isMVar then
+        if ← isDefEqS rhs lhs then
+          vc.assign (mkApp2 (mkConst ``Eq.refl [← Sym.getLevel T]) T lhs)
+          continue
+    rest := rest.push vc
+  return rest.toList
+
+/-- Distill the join point `have jp := fun xs => k xs; body` of the do-elaborator into an abstract
+join point. The abstract hole becomes `have jp' := ?k'; ?B jp'`. The goal for `body` receives `jp'`
+and the spec `∀ xs ss x₁' h₁ … xₙ' hₙ, ?H xs ss → ⊤ ⊑ wrp γ (jp xs) (jp' xs') Q E ss`, where
+`hᵢ : PureRefinement xᵢ xᵢ' True Rᵢ` is the entry of the join parameter `xᵢ`. The goal for the join
+RHS is `∀ xs ss x₁' h₁ … xₙ' hₙ, ?H xs ss → ⊤ ⊑ wrp γ (k xs) (?k' xs') Q E ss`. `wpAbsJump?` closes each jump with
+the spec, and `finalizeJoinPoint` assigns `?H` before the run reaches the join RHS, as in
+`vcgen +jp`. The join RHS is distilled once, into `?k'`. -/
+def wpJoinPoint? (scope : Scope) (goal : MVarId) (info : WRPApp) :
+    VCGenM (Option (Scope × List MVarId)) := do
+  let .letE name type val body nondep := info.prog | return none
+  unless Lean.Elab.Tactic.Do.isJP name && val.isLambda do return none
+  let abs ← instantiateMVarsIfMVarAppS info.abs
+  unless abs.getAppFn.isMVar do return none
+  let saved ← (saveState : MetaM Meta.SavedState)
+  let some r ← goal.withContext do
+    let numParams ← Lean.Elab.Tactic.Do.getNumJoinParams type info.Prog
+    -- The join parameters, with a fresh abstract type and relation for each one but a `PUnit`.
+    let some paramTys ← forallBoundedTelescope type numParams fun xs _ => do
+        let tys ← xs.mapM fun x => do instantiateMVars (← Sym.inferType x)
+        if tys.any (·.hasAnyFVar (xs.map (·.fvarId!)).contains) then return none
+        return some (← tys.mapM (shareCommon ·))
+      | return none
+    let params ← paramTys.mapM fun T => do
+      if T.isAppOf ``PUnit then return none
+      let v ← mkFreshLevelMVar
+      let τ ← shareCommon (← mkFreshExprMVar (← mkSortS (.succ v)))
+      let R ← shareCommon (← mkFreshExprMVar
+        (← mkForallS `c .default T (← mkForallS `a .default τ (← mkSortS .zero))))
+      return some (τ, R)
+    let (goal, filled) ← fillAbstractHole goal info
+    let some (_, _, b) := filled | return none
+    let AProg ← Sym.inferType b
+    let absTys := (paramTys.zip params).map fun (T, p) => p.map (·.1) |>.getD T
+    let jpTy' ← absTys.foldrM (fun τ acc => mkForallS `x .default τ acc) AProg
+    let k ← shareCommon (← mkFreshExprMVar jpTy')
+    let B ← shareCommon (← mkFreshExprMVar (← mkForallS name .default jpTy' AProg))
+    b.mvarId!.assign (← mkLetS name jpTy' k (← mkAppS B (← mkBVarS 0)) nondep)
+    restoreHoleScope filled (withArgs := true)
+    let wp ← mkAppNS info.head ((info.args.set! WRPApp.progIdx body).set! (WRPApp.progIdx + 1) b)
+    let (jp, goal) ← introLet goal name type val (← mkAppNS wp info.excessArgs) nondep
+    goal.withContext do
+    let goalTy ← goal.getType
+    let_expr PartialOrder.rel α inst _ rhs := goalTy | return none
+    let jpFVar ← mkFVarS jp
+    let instCL ← match_expr info.instAL with
+      | Std.WP.Assertion.mk _ instCL => pure instCL
+      | _ =>
+        let lvls := (← Sym.inferType info.instAL).getAppFn.constLevels!
+        mkAppNS (← mkConstS ``Std.WP.Assertion.toCompleteLattice lvls) #[info.Pred, info.instAL]
+    let lctx ← getLCtx
+    let localInsts ← getLocalInstances
+    -- `⊤`, the hypothesis `?H`, and the entailments over the join parameters `xs`, the states `ss`
+    -- and the binders `x₁' h₁ … xₙ' hₙ` of the abstract parameters with a relation.
+    let some (hyp, top) ← forallBoundedTelescope type numParams fun xs _ => do
+        forallBoundedTelescope info.Pred info.excessArgs.size fun ss B' => do
+      let xs ← xs.mapM (mkFVarS ·.fvarId!)
+      let ss ← ss.mapM (mkFVarS ·.fvarId!)
+      let some instB ← baseInstance? instCL ss | return none
+      let some u := (← Sym.getLevel B').dec | return none
+      let top ← mkAppNS (← mkConstS ``Lean.Order.top [u]) #[← shareCommon B', instB]
+      if top.hasAnyFVar (ss.map (·.fvarId!)).contains then return none
+      let hyp ← shareCommon (← mkFreshExprMVarAt lctx localInsts
+        (← mkForallFVarsS (xs ++ ss) (← mkSortS .zero)) .syntheticOpaque)
+      return some (hyp, top)
+      | return none
+    let entails (progOf : Array Expr → VCGenM Expr) (absOf : Array Expr → VCGenM Expr) :
+        VCGenM Expr :=
+      forallBoundedTelescope type numParams fun xs _ => do
+      forallBoundedTelescope info.Pred info.excessArgs.size fun ss _ => do
+      let xs ← xs.mapM (mkFVarS ·.fvarId!)
+      let ss ← ss.mapM (mkFVarS ·.fvarId!)
+      let rec tele (i : Nat) (xs' bs : Array Expr) : VCGenM Expr := do
+        if h : i < xs.size then
+          match params[i]! with
+          | none => tele (i + 1) (xs'.push xs[i]) bs
+          | some (τ, R) =>
+            withLocalDeclD `x τ fun x' => do
+            let x' ← mkFVarS x'.fvarId!
+            withLocalDeclD `h (← mkEntryType paramTys[i]! τ xs[i] x' R) fun hx => do
+            tele (i + 1) (xs'.push x') (bs.push x' |>.push (← mkFVarS hx.fvarId!))
+        else
+          let wp ← mkAppNS (← mkAppNS info.head
+            ((info.args.set! WRPApp.progIdx (← progOf xs)).set! (WRPApp.progIdx + 1) (← absOf xs'))) ss
+          let rel ← mkAppNS (← mkConstS ``PartialOrder.rel goalTy.getAppFn.constLevels!)
+            #[α, inst, top, wp]
+          mkForallFVarsS (xs ++ ss ++ bs) (← mkForallS `h .default (← mkAppNS hyp (xs ++ ss)) rel)
+      tele 0 #[] #[]
+    let rhsTy ← entails (betaS val ·) (mkAppNS k ·)
+    let mkSpecTy (J : Expr) : VCGenM Expr := entails (mkAppNS jpFVar ·) (mkAppNS J ·)
+    let rhsGoal ← mkFreshExprSyntheticOpaqueMVar (← shareCommon rhsTy) (← goal.getTag)
+    let bodyTy ← withLocalDeclD name jpTy' fun J => do
+      let J ← mkFVarS J.fvarId!
+      let specTy ← mkSpecTy J
+      withLocalDeclD `__do_jp_spec specTy fun S => do
+        let S ← mkFVarS S.fvarId!
+        let rhs' ← mkAppNS rhs.getAppFn (rhs.getAppArgs.set! (WRPApp.progIdx + 1) (← mkAppS B J))
+        let rel ← mkAppNS goalTy.getAppFn (goalTy.getAppArgs.set! 3 rhs')
+        mkForallFVarsS #[J, S] rel
+    let bodyGoal ← mkFreshExprSyntheticOpaqueMVar (← shareCommon bodyTy) (← goal.getTag)
+    goal.assign (mkApp2 bodyGoal k rhsGoal)
+    let .goal decls g ← Sym.introN bodyGoal.mvarId! 2
+      | throwError "distill: failed to introduce the abstract join point {name}"
+    let joinPoint : JoinPoint :=
+      { spec := ← mkFVarS decls[1]!, top, hyp := hyp.mvarId!, rhsGoal := rhsGoal.mvarId!,
+        numStates := info.excessArgs.size }
+    modify fun s => { s with
+      pendingJoinPoints := s.pendingJoinPoints.insert joinPoint.rhsGoal (joinPoint, #[]) }
+    absJoinPointsExt.modifyState (·.insert jp { jp := joinPoint, abs := ← mkFVarS decls[0]!, params })
+    trace[Elab.Tactic.Do.vcgen] "abstract join point: {name}"
+    return some (scope, [g, rhsGoal.mvarId!])
+    | (saved.restore : MetaM Unit); return none
+  return some r
+
+/-- Close the goal `⊤ ⊑ wrp γ (jp vs) A Q E ss` of a jump to an abstract join point with the spec
+`spec vs ss v₁' h₁ … vₙ' hₙ ?pf`. The value solver abstracts each argument `vᵢ` to `vᵢ'`, and the abstract
+program `A` becomes `jp' vs'`. `finalizeJoinPoint` assigns `?pf : ?H vs ss`. -/
+def wpAbsJump? (goal : MVarId) (info : WRPApp) : VCGenM (Option (List MVarId)) := do
+  let some fv := info.prog.getAppFn.fvarId? | return none
+  let some ajp := (← absJoinPointsExt.getState)[fv]? | return none
+  let jp := ajp.jp
+  goal.withContext do
+  let_expr PartialOrder.rel _ _ pre _ := (← goal.getType) | return none
+  unless pre == jp.top && info.excessArgs.size == jp.numStates do return none
+  let args := info.prog.getAppArgs
+  unless args.size == ajp.params.size do return none
+  let saved ← (saveState : MetaM Meta.SavedState)
+  let some r ← do
+    let (goal, filled) ← fillAbstractHole goal info
+    let some (_, _, b) := filled | return none
+    let mut absArgs := #[]
+    let mut bs := #[]
+    let mut vcs := #[]
+    for a in args, p in ajp.params do
+      let some (τ, R) := p | absArgs := absArgs.push a; continue
+      let a' ← shareCommon (← mkFreshExprMVar τ)
+      let T ← Sym.inferType a
+      let h ← mkFreshExprSyntheticOpaqueMVar (← shareCommon (← mkEntryType T τ a a' R))
+      let some solved ← (try some <$> solvePureRefinement h.mvarId! catch _ => pure none)
+        | return none
+      vcs := vcs ++ (← closeValEqs solved)
+      let a' ← instantiateMVarsS a'
+      absArgs := absArgs.push a'
+      bs := bs.push a' |>.push h
+    b.mvarId!.assign (← mkAppNS ajp.abs absArgs)
+    unless ← filledInScope filled do return none
+    restoreHoleScope filled
+    let pf ← shareCommon (← mkFreshExprSyntheticOpaqueMVar
+      (← mkAppNS (← mkMVarS jp.hyp) (args ++ info.excessArgs)))
+    goal.assign (mkAppN jp.spec (args ++ info.excessArgs ++ bs |>.push pf))
+    modify fun s => { s with
+      pendingJoinPoints := s.pendingJoinPoints.modify jp.rhsGoal fun (jp, jumps) =>
+        (jp, jumps.push { proof := pf.mvarId!, args := args ++ info.excessArgs }) }
+    trace[Elab.Tactic.Do.vcgen] "abstract jump: {info.prog} ↦ {← instantiateMVarsS b}"
+    return some vcs.toList
+    | (saved.restore : MetaM Unit); return none
+  return some r
+
+/-- Rewrite the concrete program of `goal` by `hprog : info.prog = prog'`. -/
+def rewriteProg (goal : MVarId) (info : WRPApp) (prog' hprog : Expr) : VCGenM MVarId := do
+  let prog := info.prog
+  let target ← goal.getType
+  let relArgs := target.getAppArgs
+  let wp ← mkAppNS info.head <| info.args.set! WRPApp.progIdx prog'
+  let target' ← mkAppNS target.getAppFn (relArgs.set! (relArgs.size - 1) (← mkAppNS wp info.excessArgs))
+  let g' ← mkFreshExprSyntheticOpaqueMVar (← shareCommon target') (← goal.getTag)
+  let progTy ← Sym.inferType prog
+  let w ← Sym.getLevel progTy
+  let motive := mkLambda `p .default progTy <|
+    mkAppN target.getAppFn (relArgs.set! (relArgs.size - 1)
+      (mkAppN (mkAppN info.head (info.args.set! WRPApp.progIdx (mkBVar 0))) info.excessArgs))
+  let hTarget := mkApp6 (mkConst ``congrArg [w, 1]) progTy (mkSort 0) prog prog' motive hprog
+  goal.assign (mkApp4 (mkConst ``Eq.mpr [0]) target target' hTarget g')
+  return g'.mvarId!
+
+/-- The `MatchChain`s of the matchers that the run has seen. -/
+initialize matchChainExt : SymExtension (Std.HashMap Name (Option MatchChain)) ←
+  registerSymExtension (pure {})
+
+/-- Cached version of `mkMatchChain`. Cache key: the matcher name. -/
+def mkMatchChainCached (matcherName : Name) : VCGenM (Option MatchChain) := do
+  if let some chain := (← matchChainExt.getState)[matcherName]? then return chain
+  let chain ← liftMetaM <| withNewMCtxDepth <| mkMatchChain matcherName
+  let chain ← chain.mapM fun c => return { c with
+    rhs := ← shareCommon c.rhs, proof := ← shareCommon c.proof }
+  matchChainExt.modifyState (·.insert matcherName chain)
+  return chain
+
+/-- Strategy 11a: rewrite a matcher whose discriminant `d` mentions a variable outside the context of
+the abstract hole, such as a value that the run read from the concrete state, into a chain of
+`dite`s (`mkMatchChain`). The matcher has one discriminant, a motive that does not depend on it, no
+equation name of it, closed patterns `pᵢ`, and at most a final variable pattern:
+`match d with | 0 => A | 1 => B | x => C x` becomes
+`if h : d = 0 then A else if h : d = 1 then B else C d`. The equations of the matcher prove the
+rewrite. Then `wpAbstractCond?` abstracts each condition `d = pᵢ` under the relations of the value
+solver, such as `w = 0#8` to `n = 0` for a word `w` with the number `n`. A matcher outside this
+class stays as it is. -/
+def wpMatchChain? (goal : MVarId) (info : WRPApp) : VCGenM (Option MVarId) := goal.withContext do
+  let prog := info.prog
+  let some m ← liftMetaM <| Meta.matchMatcherApp? prog | return none
+  unless m.discrs.size == 1 && m.remaining.isEmpty do return none
+  let d := m.discrs[0]!
+  -- A chain that another branch synthesized makes the abstract program a `dite`.
+  match ← outsideHole? info with
+  | some outside => unless outside d do return none
+  | none => unless (← instantiateMVarsS info.abs).isAppOfArity ``dite 5 do return none
+  let .lam _ _ T _ := m.motive | return none
+  if T.hasLooseBVars then return none
+  let some chain ← mkMatchChainCached m.matcherName | return none
+  let us := m.matcherLevels.toList
+  let args := m.params ++ #[← shareCommon T, d] ++ m.alts
+  let rhs ← shareCommon (chain.rhs.instantiateLevelParams chain.levelParams us)
+  let prog' ← instantiateRevBetaS (args.foldl (fun e _ => e.bindingBody!) rhs) args
+  let hprog := mkAppN (chain.proof.instantiateLevelParams chain.levelParams us) args
+  trace[Elab.Tactic.Do.vcgen] "match chain: {prog'}"
+  return some (← rewriteProg goal info prog' hprog)
+
+/-- Strategy 11a: abstract the condition of an `ite`, `dite` or `cond`, or a discriminant of a
+matcher, that mentions a variable outside the context of the abstract hole, such as a value that the
+run read from the concrete state. The value solver gives the abstract value `ad` with `d = ad` under
+the relation `Eq`, and the concrete program is rewritten to split on `ad`, so the split of
+`wpMatch?` gives the abstract program a condition in the hole's context. The guards of the
+solution are verification conditions. A matcher whose motive depends on its discriminants, or
+that names an equation of a discriminant, stays as it is. -/
+def wpAbstractCond? (goal : MVarId) (info : WRPApp) : VCGenM (Option (List MVarId)) :=
+    goal.withContext do
+  let prog := info.prog
+  let isIte := prog.isAppOfArity ``ite 5
+  let isDite := prog.isAppOfArity ``dite 5
+  let isCond := prog.isAppOfArity ``cond 4
+  -- A split that another branch synthesized fixes the abstract condition or discriminant: the
+  -- argument at a position where the two programs differ.
+  let abs ← instantiateMVarsS info.abs
+  let hole? ← outsideHole? info
+  let given := hole?.isNone
+  if given && !(abs.getAppFn == prog.getAppFn && abs.getAppNumArgs == prog.getAppNumArgs) then
+    return none
+  let outside : Nat → Expr → Bool := fun i d => match hole? with
+    | some f => f d
+    | none => d != abs.getArg! i
+  -- The position of the abstracted argument: the condition, or the first discriminant of a matcher
+  -- whose motive does not depend on the discriminants.
+  let mut idx? : Option Nat := none
+  if isIte || isDite || isCond then
+    idx? := some 1
+  else if let some m ← liftMetaM <| Meta.matchMatcherApp? prog then
+    let independent ← liftMetaM <| Meta.lambdaTelescope m.motive fun ys body =>
+      pure (ys.size == m.discrs.size && !body.hasAnyFVar (ys.map (·.fvarId!)).contains)
+    if independent && m.discrInfos.all (·.hName?.isNone) then
+      let off := m.params.size + 1
+      if let some i := (List.range m.discrs.size).find? fun i => outside (off + i) m.discrs[i]! then
+        idx? := some (off + i)
+  let some idx := idx? | return none
+  let d := prog.getArg! idx
+  unless outside idx d do return none
+  let T ← Sym.inferType d
+  let l ← Sym.getLevel T
+  let v := l.dec.getD levelZero
+  let ad ← if given then pure (abs.getArg! idx) else shareCommon (← mkFreshExprMVar T)
+  let eqT ← mkAppNS (← mkConstS ``Eq [l]) #[T]
+  let gTy ← mkAppNS (← mkConstS ``Distillery.PureRefinement [v, v])
+    #[T, T, d, ad, ← mkConstS ``True, eqT]
+  let g ← mkFreshExprSyntheticOpaqueMVar (← shareCommon gTy)
+  let saved ← (saveState : MetaM Meta.SavedState)
+  let mut vcs := #[]
+  for vc in ← solvePureRefinement g.mvarId! do
+    let ty ← instantiateMVarsS (← vc.getType)
+    if let some (_, lhs, rhs) := ty.eq? then
+      if given || (← instantiateMVarsS rhs).isMVar then
+        if ← isDefEqS rhs lhs then
+          vc.assign (mkApp2 (mkConst ``Eq.refl [l]) T lhs)
+          continue
+        if given then
+          (saved.restore : MetaM Unit)
+          return none
+    vcs := vcs.push vc
+  let ad ← instantiateMVarsS ad
+  if !given && (outside idx ad || ad.hasExprMVar) then return none
+  -- `hc : d = ad`
+  let hc := mkApp g (mkConst ``True.intro)
+  let fn := prog.getAppFn
+  let w ← Sym.getLevel (← Sym.inferType prog)
+  let args := prog.getAppArgs
+  let (prog', hprog) ← if !(isIte || isDite) then do
+      -- `cond` and matchers: replace the argument by `congrArg`.
+      let prog' ← mkAppNS fn (args.set! idx ad)
+      let progTy ← Sym.inferType prog
+      let motive := mkLambda `z .default T (mkAppN fn (args.set! idx (mkBVar 0)))
+      pure (prog', mkApp6 (mkConst ``congrArg [l, ← Sym.getLevel progTy]) T progTy d ad motive hc)
+    else do
+      let α := args[0]!
+      let inst ← mkAppNS (← mkConstS ``Classical.propDecidable) #[ad]
+      if isIte then
+        let prog' ← mkAppNS fn #[α, ad, inst, args[3]!, args[4]!]
+        let rflT := mkLambda `h .default ad (mkApp2 (mkConst ``Eq.refl [w]) α args[3]!)
+        let rflE := mkLambda `h .default (mkNot ad) (mkApp2 (mkConst ``Eq.refl [w]) α args[4]!)
+        pure (prog', mkAppN (mkConst ``ite_congr [w])
+          #[α, d, ad, args[3]!, args[4]!, args[3]!, args[4]!, args[2]!, inst, hc, rflT, rflE])
+      else do
+        -- `dite d t e` becomes `dite ad (fun h => t (hc ▸ h)) (fun h => e (hc ▸ h))`.
+        let notD ← mkAppNS (← mkConstS ``Not) #[d]
+        let notAd ← mkAppNS (← mkConstS ``Not) #[ad]
+        let hNot := mkApp6 (mkConst ``congrArg [1, 1]) (mkSort 0) (mkSort 0) d ad (mkConst ``Not) hc
+        let castT ← shareCommon (mkApp4 (mkConst ``Eq.mpr [0]) d ad hc (mkBVar 0))
+        let castE ← shareCommon (mkApp4 (mkConst ``Eq.mpr [0]) notD notAd hNot (mkBVar 0))
+        let t' ← mkLambdaS `h .default ad (← mkAppS args[3]! castT)
+        let e' ← mkLambdaS `h .default notAd (← mkAppS args[4]! castE)
+        let prog' ← mkAppNS fn #[α, ad, inst, t', e']
+        let rflT := mkLambda `h .default ad (mkApp2 (mkConst ``Eq.refl [w]) α (mkApp t' (mkBVar 0)))
+        let rflE := mkLambda `h .default notAd (mkApp2 (mkConst ``Eq.refl [w]) α (mkApp e' (mkBVar 0)))
+        pure (prog', mkAppN (mkConst ``dite_congr [w])
+          #[d, ad, α, args[2]!, inst, args[3]!, t', args[4]!, e', hc, rflT, rflE])
+  let g' ← rewriteProg goal info prog' hprog
+  trace[Elab.Tactic.Do.vcgen] "abstract condition: {d} ↦ {ad}"
+  return some (g' :: vcs.toList)
+
